<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NO PAIN NO GAIN · 健身海报</title>
<style>
  /* ===== 基础重置 ===== */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
    background: #0a0a0a;
    color: #fff;
    overflow-x: hidden;
    line-height: 1.6;
  }

  /* ===== 荧光绿强调色 ===== */
  :root {
    --neon: #c8ff00;
    --dark: #0a0a0a;
    --gray: #1a1a1a;
  }

  /* ===== 顶部导航 ===== */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 28px;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(12px);
    z-index: 100;
    border-bottom: 1px solid rgba(200, 255, 0, 0.15);
  }
  .logo {
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 3px;
    color: var(--neon);
  }
  .nav-links a {
    color: #aaa;
    text-decoration: none;
    margin-left: 24px;
    font-size: 14px;
    transition: color 0.3s;
  }
  .nav-links a:hover {
    color: var(--neon);
  }

  /* ===== 首屏大标题 ===== */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 120px 28px 60px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    top: -30%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(200,255,0,0.18) 0%, transparent 70%);
    border-radius: 50%;
    z-index: 0;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 700px;
  }
  .tagline {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 4px;
    color: var(--neon);
    border: 1px solid var(--neon);
    padding: 6px 16px;
    border-radius: 30px;
    margin-bottom: 24px;
    text-transform: uppercase;
  }
  .hero h1 {
    font-size: clamp(48px, 12vw, 110px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -2px;
    margin-bottom: 20px;
  }
  .hero h1 .stroke {
    color: transparent;
    -webkit-text-stroke: 2px var(--neon);
  }
  .hero h1 .fill {
    color: var(--neon);
  }
  .hero p {
    font-size: 16px;
    color: #999;
    max-width: 460px;
    margin-bottom: 36px;
  }
  .btn-group {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 14px 34px;
    font-size: 15px;
    font-weight: 700;
    border-radius: 50px;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: all 0.3s;
  }
  .btn-primary {
    background: var(--neon);
    color: #000;
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(200,255,0,0.35);
  }
  .btn-ghost {
    background: transparent;
    color: #fff;
    border: 1px solid #444;
  }
  .btn-ghost:hover {
    border-color: var(--neon);
    color: var(--neon);
  }

  /* ===== 数据统计条 ===== */
  .stats {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 20px;
    padding: 50px 28px;
    border-top: 1px solid #1e1e1e;
    border-bottom: 1px solid #1e1e1e;
    background: #0d0d0d;
  }
  .stat-item {
    text-align: center;
  }
  .stat-num {
    font-size: 42px;
    font-weight: 900;
    color: var(--neon);
    line-height: 1;
  }
  .stat-label {
    font-size: 13px;
    color: #777;
    margin-top: 8px;
    letter-spacing: 1px;
  }

  /* ===== 课程卡片区 ===== */
  .section {
    padding: 80px 28px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .section-title {
    font-size: 32px;
    font-weight: 900;
    margin-bottom: 12px;
    letter-spacing: -1px;
  }
  .section-title span {
    color: var(--neon);
  }
  .section-sub {
    color: #777;
    font-size: 15px;
    margin-bottom: 44px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
  }
  .card {
    background: var(--gray);
    border: 1px solid #222;
    border-radius: 18px;
    padding: 32px 26px;
    transition: all 0.35s;
    position: relative;
    overflow: hidden;
  }
  .card::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--neon);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s;
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: rgba(200,255,0,0.4);
  }
  .card:hover::after {
    transform: scaleX(1);
  }
  .card-icon {
    font-size: 34px;
    margin-bottom: 16px;
  }
  .card h3 {
    font-size: 19px;
    margin-bottom: 10px;
    font-weight: 700;
  }
  .card p {
    font-size: 14px;
    color: #888;
  }

  /* ===== 引用语 ===== */
  .quote {
    text-align: center;
    padding: 100px 28px;
    background: linear-gradient(135deg, #0d0d0d 0%, #111 100%);
    border-top: 1px solid #1e1e1e;
    border-bottom: 1px solid #1e1e1e;
  }
  .quote p {
    font-size: clamp(22px, 5vw, 40px);
    font-weight: 900;
    line-height: 1.35;
    max-width: 800px;
    margin: 0 auto;
    letter-spacing: -1px;
  }
  .quote .highlight {
    color: var(--neon);
  }
  .quote .author {
    margin-top: 24px;
    font-size: 14px;
    color: #666;
    font-weight: 400;
    letter-spacing: 2px;
  }

  /* ===== CTA 底部 ===== */
  .cta {
    text-align: center;
    padding: 90px 28px;
  }
  .cta h2 {
    font-size: clamp(28px, 6vw, 48px);
    font-weight: 900;
    margin-bottom: 18px;
  }
  .cta h2 span {
    color: var(--neon);
  }
  .cta p {
    color: #888;
    margin-bottom: 36px;
    font-size: 15px;
  }

  /* ===== 页脚 ===== */
  .footer {
    text-align: center;
    padding: 30px;
    border-top: 1px solid #1a1a1a;
    color: #555;
    font-size: 13px;
  }

  /* ===== 滚动动画 ===== */
  .fade-in {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .fade-in.show {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== 手机适配 ===== */
  @media (max-width: 600px) {
    .nav {
      padding: 14px 18px;
    }
    .nav-links a {
      margin-left: 14px;
      font-size: 13px;
    }
    .hero {
      padding: 100px 20px 50px;
    }
    .section {
      padding: 60px 20px;
    }
    .stat-num {
      font-size: 32px;
    }
  }
</style>
</head>
<body>

<!-- 顶部导航 -->
<nav class="nav">
  <div class="logo">IRON PULSE</div>
  <div class="nav-links">
    <a href="#courses">课程</a>
    <a href="#quote">理念</a>
    <a href="#join">加入</a>
  </div>
</nav>

<!-- 首屏大标题 -->
<section class="hero">
  <div class="hero-content">
    <span class="tagline">Stronger Every Day</span>
    <h1>
      NO PAIN<br>
      <span class="stroke">NO</span> <span class="fill">GAIN</span>
    </h1>
    <p>汗水不会说谎，坚持终将回报。从今天开始，用训练雕刻更好的自己。</p>
    <div class="btn-group">
      <a href="#join" class="btn btn-primary">立即加入</a>
      <a href="#courses" class="btn btn-ghost">查看课程</a>
    </div>
  </div>
</section>

<!-- 数据统计 -->
<section class="stats">
  <div class="stat-item">
    <div class="stat-num" data-target="1200">0</div>
    <div class="stat-label">活跃会员</div>
  </div>
  <div class="stat-item">
    <div class="stat-num" data-target="36">0</div>
    <div class="stat-label">专业教练</div>
  </div>
  <div class="stat-item">
    <div class="stat-num" data-target="98">0</div>
    <div class="stat-label">满意度 %</div>
  </div>
  <div class="stat-item">
    <div class="stat-num" data-target="24">0</div>
    <div class="stat-label">小时开放</div>
  </div>
</section>

<!-- 课程卡片 -->
<section class="section" id="courses">
  <h2 class="section-title fade-in">选择你的<span>训练方向</span></h2>
  <p class="section-sub fade-in">无论增肌、减脂还是塑形，这里都有适合你的课程。</p>
  <div class="cards">
    <div class="card fade-in">
      <div class="card-icon">🏋️</div>
      <h3>力量训练</h3>
      <p>深蹲、硬拉、卧推，系统提升基础力量与肌肉围度。</p>
    </div>
    <div class="card fade-in">
      <div class="card-icon">🔥</div>
      <h3>燃脂 HIIT</h3>
      <p>高强度间歇训练，短时间高效燃烧卡路里。</p>
    </div>
    <div class="card fade-in">
      <div class="card-icon">🧘</div>
      <h3>柔韧塑形</h3>
      <p>瑜伽与普拉提结合，改善体态，增强核心稳定性。</p>
    </div>
    <div class="card fade-in">
      <div class="card-icon">🥊</div>
      <h3>搏击格斗</h3>
      <p>拳击、泰拳基础，释放压力的同时全面提升体能。</p>
    </div>
  </div>
</section>

<!-- 引用语 -->
<section class="quote" id="quote">
  <p class="fade-in">
    "你流下的每一滴汗，<br>
    都会变成<span class="highlight">更好的自己</span>。"
  </p>
  <div class="author">— IRON PULSE 健身</div>
</section>

<!-- 底部 CTA -->
<section class="cta" id="join">
  <h2 class="fade-in">准备好了吗？<span>开始你的蜕变</span></h2>
  <p class="fade-in">首次体验课免费，名额有限，立即预约。</p>
  <a href="#" class="btn btn-primary fade-in">免费预约体验课</a>
</section>

<!-- 页脚 -->
<footer class="footer">
  © 2026 IRON PULSE 健身工作室 · 让坚持成为习惯
</footer>

<script>
  // ===== 数字滚动动画 =====
  const counters = document.querySelectorAll('.stat-num');
  let counted = false;

  function runCounter() {
    if (counted) return;
    const statsSection = document.querySelector('.stats');
    const rect = statsSection.getBoundingClientRect();
    if (rect.top < window.innerHeight - 100) {
      counted = true;
      counters.forEach(counter => {
        const target = +counter.getAttribute('data-target');
        let current = 0;
        const step = Math.ceil(target / 60);
        const timer = setInterval(() => {
          current += step;
          if (current >= target) {
            counter.textContent = target;
            clearInterval(timer);
          } else {
            counter.textContent = current;
          }
        }, 20);
      });
    }
  }

  // ===== 滚动淡入动画 =====
  const fadeEls = document.querySelectorAll('.fade-in');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('show');
      }
    });
  }, { threshold: 0.15 });

  fadeEls.forEach(el => observer.observe(el));

  // ===== 监听滚动 =====
  window.addEventListener('scroll', runCounter);
  window.addEventListener('load', runCounter);
</script>

</body>
</html>
